NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-27
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=
NEXT_PUBLIC_SITE_URL=
# Pre-cutover: use the Vercel alias (https://stefanie-schumacher-com.vercel.app)
# so absolute URLs in feeds/OG/sitemap resolve to a live Next host.
# At DNS cutover: switch to https://stefanie-schumacher.com
# Host-based noindex still blocks *.vercel.app regardless of this value.
RESEND_API_KEY=
# Workshop Announcements segment — required (band + footer)
RESEND_SEGMENT_WORKSHOPS_ID=
# Blog & Practice Updates — optional; only when band checkbox is ticked
RESEND_SEGMENT_BLOG_PRACTICE_ID=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Stripe secret for Payment Links / Checkout Session lookup (server only).
STRIPE_SECRET_KEY=
# Stripe webhook signing secret for POST /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
# From address on transactional workshop emails (confirmations + credentials).
WORKSHOP_FROM_EMAIL=
# Reply-To on transactional workshop emails.
WORKSHOP_REPLY_TO=
# Bearer token Vercel Cron sends to /api/cron/workshop-credentials.
CRON_SECRET=
# Deprecated — old product-ID /admin path removed. Still may exist on Vercel; unused in code.
# STRIPE_SERIES_PRODUCT_ID=
# ADMIN_USER=
# ADMIN_PASSWORD=
