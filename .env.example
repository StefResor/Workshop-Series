NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-27
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=
NEXT_PUBLIC_SITE_URL=
# Pre-cutover: use the Vercel alias (https://stefanie-schumacher-com.vercel.app)
# so absolute URLs in feeds/OG/sitemap resolve to a live Next host.
# At DNS cutover: switch to https://stefanie-schumacher.com
# Host-based noindex still blocks *.vercel.app regardless of this value.
RESEND_API_KEY=
# Website Signups segment (public band/footer). Full-access key required for contacts.
RESEND_SEGMENT_ID=
# Topic IDs — both opted in at signup when set (missing → segment only + warn)
RESEND_TOPIC_WORKSHOP_ANNOUNCEMENTS_ID=
RESEND_TOPIC_PRACTICE_NEWS_ID=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Product ID for the full 10-session series pass (prod_…).
STRIPE_SERIES_PRODUCT_ID=
# HTTP Basic auth for /admin and /api/admin (generated password; empty/whitespace → 503)
ADMIN_USER=
ADMIN_PASSWORD=
